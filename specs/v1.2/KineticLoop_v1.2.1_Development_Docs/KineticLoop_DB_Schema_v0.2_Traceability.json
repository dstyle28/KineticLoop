  "transactions": [
    {
      "id": "T1",
      "atomic_writes": "S09 raw evidence + S02 receipt + S03/S04 接收事件；解析候选另开短事务写 S10",
      "guards": "subject/source idempotency、内容身份冲突",
      "exclusions": "不接受未解析候选为训练成功；不重算特征"
    },
    {
      "id": "T2",
      "atomic_writes": "IN：S12/S13/S14 或 S17/S18 + S01 frontier/epoch/basis + S43/events/receipt；SEAL：S15 READY→SEALED + S01 factset head/events/receipt；GLOBAL：S50 + S51 revision/管理 receipt；三者是独立原子命令",
      "guards": "IN：输入/actor/失效分类；SEAL：captured frontier/epoch/member revision/完成凭据；GLOBAL：管理 capability/identity + exclusive registry gate",
      "exclusions": "不把 IN 与 SEAL 假装跨构建原子；不在 S01 锁内批量写 S16；不逐用户 revoke"
    },
    {
      "id": "T3",
      "atomic_writes": "READY S23 guard；S24/S25 + S01 generation/current pointer + S23 published + S03/S04/S02",
      "guards": "sealed factset/input frontier、所有 dependency basis、当前 program/policy/epoch、validity、shared registry/current artifact eligibility",
      "exclusions": "不在事务内算 projection；不发布混合结果"
    },
    {
      "id": "T4",
      "atomic_writes": "S30 准入配额、S27 intent、S28 request revision、S29 初始/失效状态、S02/S03/S04",
      "guards": "single-flight partition、request fingerprint、root admission limits",
      "exclusions": "不因改约束重置预算/deadline"
    },
    {
      "id": "T5",
      "atomic_writes": "lease/fence 变更；或 S31 reservation + S32 ledger + S27 counters；或 dispatch permit transition；均为独立短事务",
      "guards": "intent live、request revision、owner/fence/lease/deadline、预算余量",
      "exclusions": "网络请求发生在 DISPATCH_INTENT 持久化之后、事务之外"
    },
    {
      "id": "T6",
      "atomic_writes": "S39/S40/S41、S42、S38 head switch、S27 result/success、S29 committed、S02/S03/S04",
      "guards": "current snapshot/generation/epoch/request/fence/lease、policy、validation bindings、当前执行暴露、scope 和 active bundle、shared registry/current artifact eligibility、依赖有效期闭包",
      "exclusions": "不靠 schema valid / validation PASS 单独放行；不先提交 bundle 再异步签授权"
    },
    {
      "id": "T7",
      "atomic_writes": "S44 execution + S45 START/RESUME binding + S02/S03/S04",
      "guards": "当前 A/P/content/scope、依赖有效期、epoch/holds、shared registry/current artifact eligibility、session lifecycle、重复 start",
      "exclusions": "不需要在线 LLM；不改历史 START 绑定"
    },
    {
      "id": "T8",
      "atomic_writes": "S31/S32 与 S27 核算；或 reaper 对 S27/S29 的失权/终态；S02/S03/S04",
      "guards": "receipt identity、当前 reservation transition；或当前 fence/lease/deadline",
