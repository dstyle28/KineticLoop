  "invariants_count": 18,
  "invariants": [
    {
      "id": "INV-01",
      "text": "Prescription 中的计划值 MUST NOT 补全 actual execution。"
    },
    {
      "id": "INV-02",
      "text": "模型自报 confidence、reasoning、citation 或 command text 不产生 admission/approval/authorization。"
    },
    {
      "id": "INV-03",
      "text": "同一 underlying event 的多来源记录 MUST NOT 增加独立训练事件计数。"
    },
    {
      "id": "INV-04",
      "text": "无法证明成功，不等于没有 physiological exposure。"
    },
    {
      "id": "INV-05",
      "text": "Evidence Resolver 的覆盖范围由动作政策定义，不能由 Agent 的引用列表缩窄。"
    },
    {
      "id": "INV-06",
      "text": "Projection 是否可复用由 dependency basis 决定，不由其 generation 数字是否最新决定。"
    },
    {
      "id": "INV-07",
      "text": "只有 Manifest 的原子发布递增 decision_generation。"
    },
    {
      "id": "INV-08",
      "text": "用户与全局制品紧急失效不等待模型、projection、Manifest、替代计划或逐用户 fanout。"
    },
    {
      "id": "INV-09",
      "text": "Authorization 的内容、epoch、scope、依赖有效期闭包、控制状态及传递制品未撤销资格必须共同有效。"
    },
    {
      "id": "INV-10",
      "text": "失效的旧 Manifest / 旧 attempt / 被撤销制品不能重新产生执行权限。"
    },
    {
      "id": "INV-11",
      "text": "所有 attempt、repair、stale restart 和实际外部请求共享根预算。"
    },
    {
      "id": "INV-12",
      "text": "外部调用结果未知不恢复已占用预算；晚到结果不恢复失去的提交权。"
    },
    {
      "id": "INV-13",
      "text": "新 request revision 使旧 attempt 失权，不重置根预算。"
    },
    {
      "id": "INV-14",
      "text": "替换 Fitness 内容必然使依赖其内容的 Demand 与 Nutrition 失效。"
    },
    {
      "id": "INV-15",
      "text": "模型摘要始终为非命令推断；转换或重复总结不能提升 trust / authority。"
    },
    {
      "id": "INV-16",
      "text": "Replay 不能读取 knowledge cutoff 之后才被系统知道的个体证据及人工修正。"
    },
    {
      "id": "INV-17",
      "text": "LLM 等待、外部网络调用、长时间特征计算 MUST NOT 发生在协调事务内。"
    },
    {
      "id": "INV-18",
      "text": "授权只决定建议可否执行，不能阻止保存用户实际上已经发生的训练事实。"
    }
  ],
