{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kineticloop/milestone-closure-v0.2",
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_identity",
        "display_task_id",
        "integration_record",
        "sha256"
      ],
      "properties": {
        "task_identity": {
          "type": "string",
          "pattern": "^harness-backlog-v0\\.2/KL-[0-9]{3}[A-Z]?$"
        },
        "display_task_id": {
          "type": "string",
          "pattern": "^KL-[0-9]{3}[A-Z]?$"
        },
        "integration_record": {
          "type": "string",
          "pattern": "^docs/exec-plans/integrations/KL-[0-9]{3}[A-Z]?\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "historical_model_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "independently_reproducible_protocol_model"
      ],
      "properties": {
        "status": {
          "const": "UNVERIFIED_HISTORICAL_DECLARATION"
        },
        "independently_reproducible_protocol_model": {
          "const": false
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "milestone_identity",
        "display_milestone_id",
        "closure_status",
        "evaluated_commit",
        "integrations",
        "exit_checks",
        "historical_model_evidence",
        "product_requirement_pass_claims"
      ],
      "properties": {
        "closure_status": {
          "const": "PASS"
        },
        "evaluated_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "historical_model_evidence": {
          "$ref": "#/$defs/historical_model_evidence"
        },
        "product_requirement_pass_claims": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "m3_task_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_identity",
        "check_id",
        "tested_commit",
        "result",
        "command",
        "oracle_sha256",
        "result_artifact",
        "raw"
      ],
      "properties": {
        "task_identity": {
          "type": "string",
          "pattern": "^harness-backlog-v0\\.2/KL-[0-9]{3}$"
        },
        "check_id": {
          "type": "string"
        },
        "tested_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "result": {
          "const": "PASS"
        },
        "command": {
          "type": "string"
        },
        "oracle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_artifact": {
          "$ref": "#/$defs/evidence"
        },
        "raw": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "milestone_identity": {
              "const": "harness-backlog-v0.2/M1"
            },
            "display_milestone_id": {
              "const": "M1"
            },
            "closure_status": {},
            "evaluated_commit": {},
            "integrations": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": {
                "$ref": "#/$defs/integration"
              }
            },
            "exit_checks": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check_id",
                  "result",
                  "evidence"
                ],
                "properties": {
                  "check_id": {
                    "enum": [
                      "clean_checkout_starts_test_environment",
                      "m1_m2_task_contracts_complete",
                      "historical_model_evidence_not_overclaimed"
                    ]
                  },
                  "result": {
                    "const": "PASS"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/evidence"
                    }
                  }
                }
              }
            },
            "historical_model_evidence": {},
            "product_requirement_pass_claims": {}
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "milestone_identity": {
              "const": "harness-backlog-v0.2/M2"
            },
            "display_milestone_id": {
              "const": "M2"
            },
            "closure_status": {},
            "evaluated_commit": {},
            "integrations": {
              "type": "array",
              "minItems": 12,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/integration"
              }
            },
            "exit_checks": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check_id",
                  "result",
                  "evidence"
                ],
                "properties": {
                  "check_id": {
                    "enum": [
                      "m2_task_integrations_valid",
                      "m2_regression_suite_passes",
                      "frozen_authority_and_requirement_claims_preserved",
                      "schema_rebuild_from_zero",
                      "migration_dependency_graph_documented",
                      "no_writer_bypasses_owner_subject_guard",
                      "shadow_registry_gates_precede_affected_contracts"
                    ]
                  },
                  "result": {
                    "const": "PASS"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/evidence"
                    }
                  }
                }
              }
            },
            "historical_model_evidence": {},
            "product_requirement_pass_claims": {}
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "milestone_identity",
            "display_milestone_id",
            "closure_status",
            "evaluated_commit",
            "integrations",
            "supporting_prerequisites",
            "m2_prerequisite",
            "exit_checks",
            "integrated_regression",
            "boundary_layers",
            "interleaving_layers",
            "historical_model_evidence",
            "product_requirement_pass_claims",
            "production_auto_activation",
            "shadow_executable",
            "shadow_usability_status",
            "r04_e2e_status"
          ],
          "properties": {
            "milestone_identity": {
              "const": "harness-backlog-v0.2/M3"
            },
            "display_milestone_id": {
              "const": "M3"
            },
            "closure_status": {},
            "evaluated_commit": {},
            "integrations": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/integration"
              }
            },
            "supporting_prerequisites": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/integration"
              }
            },
            "m2_prerequisite": {
              "$ref": "#/$defs/evidence"
            },
            "exit_checks": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check_id",
                  "result",
                  "task_checks"
                ],
                "properties": {
                  "check_id": {
                    "enum": [
                      "full_test_fdn_trajectory_and_repair",
                      "current_denials_and_immutable_history",
                      "nine_actual_dc_interleavings",
                      "ready_sealed_barriers",
                      "registry_commit_freshness_and_closure",
                      "validity_missing_timeless_and_expiry",
                      "isolated_test_and_evaluation_boundaries"
                    ]
                  },
                  "result": {
                    "const": "PASS"
                  },
                  "task_checks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/m3_task_check"
                    }
                  }
                }
              }
            },
            "integrated_regression": {
              "$ref": "#/$defs/evidence"
            },
            "boundary_layers": {
              "type": "array",
              "minItems": 31,
              "maxItems": 31,
              "items": {
                "type": "object"
              }
            },
            "interleaving_layers": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "type": "object"
              }
            },
            "historical_model_evidence": {},
            "product_requirement_pass_claims": {},
            "production_auto_activation": {
              "const": false
            },
            "shadow_executable": {
              "const": false
            },
            "shadow_usability_status": {
              "const": "NOT_RUN"
            },
            "r04_e2e_status": {
              "const": "NOT_RUN"
            }
          }
        }
      ]
    }
  ]
}
