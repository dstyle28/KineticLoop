ATE\s+(?:ROLE|USER)\b",\n        r"\bALTER\s+(?:ROLE|USER)\b",\n        r"\bDROP\s+(?:ROLE|USER)\b",\n        r"\bREASSIGN\s+OWNED\b",\n    ):\n        assert re.search(pattern, emitted, flags=re.IGNORECASE) is None\n0]
