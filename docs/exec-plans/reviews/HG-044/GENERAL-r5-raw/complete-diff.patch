+def function_bytes(source):
+ lines=source.splitlines(keepends=True)
+ return {n.name:''.join(lines[n.lineno-1:n.end_lineno]) for n in ast.parse(source).body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}
