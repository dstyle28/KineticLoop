+# HG044 preparation and boundaries
+
+Protected origin/master was fetched and verified at
+9268fc8dd8c071c02dc5c698274dbf6fcd112776. The initial detached checkout was clean;
+HG044 uses branch codex/hg-044-m3-closure in its existing fresh worktree.
+
+Read AGENTS, current index, governance/result/review/merge contracts, current M3
+plan and HG042 addendum, M1/M2 schema/validators, HG043 provenance validator and
+merged prerequisite results/reviews. Read matching task-thread-runner,
+protocol-guardian, pr-merge-reviewer and DB transaction review skill instructions.
+Frozen Protocol §§3 registry commit/read, 5 authorization validity and execution,
+and final freeze limitations preserve production/shadow separation and historical
+model limitations. No frozen semantics change is needed.
+
+preflight.json binds all 15 currently available M3/support integration chains and
+result hashes, M2 with M1 prerequisite, and every declared dependency merge before
+consumer base and tested SHA. KL028/KL029 are absent prospective integrations;
+backlog NOT_STARTED is never treated as evidence of absence, PASS or MERGED.
+KL078→KL076 and KL079→KL077 are proven through their actual merged Git chains.
+
+Exact scope: milestone schema, validator, new M3 validator test module and closure
+contract, delimited plan addendum, derived index/manifest and own HG044 record,
+evidence and reviews. No actual M3 closure, integration, completed task definition,
+peer packet/backlog/traceability, runtime/migration/CI/dependency or frozen writes.
+No peer worktree/database fixture lifecycle is run. HG044 uses its own temporary
+Python check environment at /private/tmp/hg044-venv; repository dependencies and
+check-tool ranges are installed there without repository dependency edits.
+
+Synthetic tests create isolated temporary Git repositories with explicitly fake
+prospective KL028/KL029 results/reviews/merges and regression logs. These are test
+input only, never official task or project completion evidence. They use regular
+Git commit/blob lookup and unchanged integration/M1/M2 validators.
+
+After final pre-review implementation/evidence commit, fresh independent GENERAL,
+PROTOCOL, DB_CONCURRENCY and SECURITY_DATA_BOUNDARY reviews are required. Only own
+review-record suffix may follow. Final gate and applicable hosted CI must pass;
+stop before actual merge for coordinator serialization across this wave.
diff --git a/docs/exec-plans/evidence/HG-044/audit.py b/docs/exec-plans/evidence/HG-044/audit.py
new file mode 100644
index 0000000..40c2b71
--- /dev/null
+++ b/docs/exec-plans/evidence/HG-044/audit.py
@@ -0,0 +1,27 @@
+"""Audit bounded HG044 diff and preserved canonical validator implementations."""
+import ast
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+root=Path.cwd();base='fa729ca4bcca0f2c2e7a2aa0601890d1356b8842'
+head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
+old=subprocess.check_output(['git','show',base+':tools/harness/validate_harness.py'],text=True)
+new=(root/'tools/harness/validate_harness.py').read_text()
+def functions(text):
+ lines=text.splitlines(keepends=True)
+ return {n.name:''.join(lines[n.lineno-1:n.end_lineno]) for n in ast.parse(text).body if isinstance(n,ast.FunctionDef)}
+before,after=functions(old),functions(new)
+preserved=['milestone_closure_errors','m2_milestone_closure_errors','m2_execution_evidence_errors','integration_record_errors','review_evidence_exists','semantic_result_errors']
+checks={name:before[name]==after[name] for name in preserved}
+changed=subprocess.check_output(['git','diff','--name-only',base,head],text=True).splitlines()
+allowed={'MILESTONE_CLOSURE.schema.json','tools/harness/validate_harness.py','tests/harness/test_m3_milestone_closure.py','docs/harness/M3_CLOSURE_CONTRACT.md','06_KineticLoop_Project_Plan_v0.6_HARNESS_HARDENED.md','CURRENT_DOCUMENT_INDEX.json','HARNESS_DOCUMENT_MANIFEST.json'}
+checks['scope']=all(p in allowed or p.startswith('docs/exec-plans/evidence/HG-044/') or p.startswith('docs/exec-plans/reviews/HG-044/') or p=='docs/exec-plans/governance/HG-044.yaml' for p in changed)
+old_plan=subprocess.check_output(['git','show',base+':06_KineticLoop_Project_Plan_v0.6_HARNESS_HARDENED.md'],text=True)
+new_plan=(root/'06_KineticLoop_Project_Plan_v0.6_HARNESS_HARDENED.md').read_text()
+checks['plan_prefix']=new_plan.split('## M3 exit-evidence mapping — HG044',1)[0]==old_plan+'\n'
+checks['no_instance']=not (root/'docs/exec-plans/milestones/M3.json').exists()
+report=dict(base_commit=base,tested_commit=head,checks=checks,changed=changed,status='PASS' if all(checks.values()) else 'FAIL',preserved_function_sha256={n:hashlib.sha256(after[n].encode()).hexdigest() for n in preserved})
+p=root/f'docs/exec-plans/evidence/HG-044/scope-{head[:7]}.json';assert not p.exists();p.write_text(json.dumps(report,indent=2)+'\n');print(report['status'])
+raise SystemExit(0 if all(checks.values()) else 1)
